# =============================================================================
# Variáveis de ambiente da API — MODELO
# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# O .env de verdade NUNCA vai para o Git (pode conter senhas).
# Quem lê estas variáveis: src/config.ts
# =============================================================================

# Porta em que a API escuta
PORT=3333

# Endereço do frontend autorizado a chamar a API (CORS)
CORS_ORIGIN=http://localhost:5173

# Ambiente: development ou production
NODE_ENV=development
