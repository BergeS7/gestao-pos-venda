# =============================================================================
# Variáveis de ambiente da API — MODELO
# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# O .env de verdade NUNCA vai para o Git (pode conter senhas).
# Quem lê estas variáveis: src/config.ts
# =============================================================================

# Porta em que a API escuta
PORT=3333

# Endereço do frontend autorizado a chamar a API (CORS)
CORS_ORIGIN=http://localhost:5173

# Ambiente: development ou production
NODE_ENV=development

# Conexão com o PostgreSQL (usada pelo Prisma)
# Formato: postgresql://USUARIO:SENHA@SERVIDOR:PORTA/BANCO?schema=public
# Localmente, o script scripts/setup-db-local.ps1 cria o banco e preenche esta linha.
DATABASE_URL="postgresql://pos_venda:TROQUE_A_SENHA@localhost:5432/gestao_pos_venda?schema=public"
